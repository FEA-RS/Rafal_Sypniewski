import pandas as pd
import numpy as np
from scipy.optimize import curve_fit
from scipy.interpolate import Rbf
import warnings
import os

warnings.filterwarnings("ignore")

# --- PARAMETRY WEJŚCIOWE ---
SHIELD_DIAMETER = 13.0
WINDOW_LONG = [-SHIELD_DIAMETER, 1.5*SHIELD_DIAMETER] # [za, przed] 
WINDOW_TRANS = 5*SHIELD_DIAMETER/2       
TIME_WINDOW_DAYS = 0    # Zoptymalizowane okno 3-dniowe    

PATHS = {
    'tbm': r"D:\%PRACA_MAGISTERSKA\data\interim\tbm_features_ring.parquet",
    'sensors': r"D:\%PRACA_MAGISTERSKA\data\interim\sensors_interpolated.parquet"
}

def peck_func_with_offset(x, s_max, i, x0):
    return s_max * np.exp(-((x - x0)**2) / (2 * i**2))

def clean_settlement(s):
    # Zakładamy: settlement_full < 0 to osiadanie (w dół)
    # Zamieniamy na dodatnie mm, ale wszystko co było > 0 (wypiętrzenie) zmieniamy na 0.
    val = s * 1000 if abs(s) < 0.2 else s
    return -val if val < 0 else 0 

def run_vloss_comparison():
    print("=" * 85)
    print("--- START ANALIZY PORÓWNAWCZEJ V_LOSS (4 METODY: GAUSS, CAŁKA, STAT, KRIGING) ---")
    print("=" * 85)
    
    if not os.path.exists(PATHS['tbm']) or not os.path.exists(PATHS['sensors']):
        print("BŁĄD: Nie znaleziono plików wejściowych!")
        return

    df_tbm = pd.read_parquet(PATHS['tbm']).sort_values('ring')
    df_sensors = pd.read_parquet(PATHS['sensors'])
    
    df_tbm['date'] = pd.to_datetime(df_tbm['timestamp']).dt.date
    df_sensors['date'] = pd.to_datetime(df_sensors['date']).dt.date
    
    v_tunnel = (np.pi * SHIELD_DIAMETER**2) / 4
    x_grid = np.linspace(-WINDOW_TRANS, WINDOW_TRANS, 200) # Siatka dla Krigingu
    
    report_list = []

    # Nagłówek tabeli w terminalu
    print(f"{'Ring':<6} | {'A: Gauss':<15} | {'B: Całka':<15} | {'C: Stat':<15} | {'D: Kriging':<15}")
    print("-" * 85)

    for idx in range(len(df_tbm)):
        ring = df_tbm.iloc[idx]
        ring_num = int(ring['ring'])
        ring_date = ring['date']
        
        mask_time = (df_sensors['date'] >= ring_date) & (df_sensors['date'] <= ring_date + pd.Timedelta(days=TIME_WINDOW_DAYS))
        pts = df_sensors[mask_time].copy()
        if pts.empty: continue

        if idx < len(df_tbm)-1:
            next_r = df_tbm.iloc[idx+1]
            bearing = np.arctan2(next_r['longitude'] - ring['longitude'], next_r['latitude'] - ring['latitude'])
        else:
            bearing = 0 

        d_lat = (pts['latitude'] - ring['latitude']) * 111132
        d_lon = (pts['longitude'] - ring['longitude']) * 71000
        pts['d_trans'] = d_lon * np.cos(bearing) - d_lat * np.sin(bearing)
        pts['d_long'] = d_lon * np.sin(bearing) + d_lat * np.cos(bearing)

        pts_ring = pts[(pts['d_long'] >= WINDOW_LONG[0]) & 
                       (pts['d_long'] <= WINDOW_LONG[1]) & 
                       (np.abs(pts['d_trans']) <= WINDOW_TRANS)].copy()
        
        if len(pts_ring) < 3: continue

        pts_ring['s_mm'] = pts_ring['settlement_safe'].apply(clean_settlement)

        pts_peak = pts_ring.groupby('sensor_id').agg({
            'd_trans': 'mean',
            's_mm': 'max'
        }).reset_index()

        x = pts_peak['d_trans'].values
        y = pts_peak['s_mm'].values
        y = np.maximum(y, 0) # Dodatkowe zabezpieczenie clampingiem

        v_a, v_b, v_c, v_d = np.nan, np.nan, np.nan, np.nan

        # --- METODA A: GAUSS FIT ---
        try:
            s_start = np.percentile(y, 95)
            popt, _ = curve_fit(
                peck_func_with_offset, x, y, 
                p0=[s_start, 15.0, 0.0], 
                bounds=([0.1, 10.0, -5.0], [200.0, 40.0, 5.0]),
                sigma=np.where(y > (s_start * 0.5), 0.5, 1.0),
                maxfev=10000, 
                method='trf'
            )
            s_a, i_a, x0_a = popt
            v_a = (np.sqrt(2*np.pi) * i_a * (s_a/1000) / v_tunnel) * 100
        except:
            pass

        # --- METODA B: INTEGRACJA 1D ---
        try:
            sort_idx = np.argsort(x)
            v_s_b = np.trapz(y[sort_idx]/1000, x[sort_idx]) 
            v_b = (v_s_b / v_tunnel) * 100
        except:
            pass

        # --- METODA C: STATYSTYCZNA (WSD) ---
        try:
            s_c = np.percentile(y, 95)
            sum_y = np.sum(y)
            weights = y / sum_y if sum_y > 0 else np.ones(len(y))/len(y)
            i_c = np.sqrt(np.sum(weights * (x**2)))
            v_c = (np.sqrt(2*np.pi) * i_c * (s_c/1000) / v_tunnel) * 100
        except:
            pass

        # --- METODA D: KRIGING RBF ---
        # Usunięto if len(x) >= 6 - teraz Rbf liczy na tym co jest, tak jak Twój stary kod
        try:
            rbf = Rbf(x, y, function='multiquadric', smooth=0.1)
            y_pred = rbf(x_grid)
            y_pred_clamped = np.maximum(y_pred, 0)
            v_s_d = np.trapz(y_pred_clamped / 1000, x_grid)
            v_d = (v_s_d / v_tunnel) * 100
        except:
            pass

        # Zapis wyników
        report_list.append({
            'ring': ring_num,
            'A_Vloss': v_a,
            'B_Vloss': v_b,
            'C_Vloss': v_c,
            'D_Vloss': v_d
        })

        # Wypisanie na ekranie
        s_a_str = f"{v_a:.3f}%" if pd.notna(v_a) else "   -   "
        s_b_str = f"{v_b:.3f}%" if pd.notna(v_b) else "   -   "
        s_c_str = f"{v_c:.3f}%" if pd.notna(v_c) else "   -   "
        s_d_str = f"{v_d:.3f}%" if pd.notna(v_d) else "   -   "

        print(f"{ring_num:<6} | {s_a_str:<15} | {s_b_str:<15} | {s_c_str:<15} | {s_d_str:<15}")

    # ==========================================
    # PODSUMOWANIE STATYSTYCZNE W TERMINALU
    # ==========================================
    if report_list:
        df_res = pd.DataFrame(report_list)
        
        print("\n" + "=" * 85)
        print("PODSUMOWANIE STATYSTYCZNE V_LOSS [%]:")
        print("=" * 85)
        print(f"{'Metoda':<15} | {'Średnia':<10} | {'Mediana':<10} | {'Odch. std':<10}")
        print("-" * 55)
        
        for col, name in zip(['A_Vloss', 'B_Vloss', 'C_Vloss', 'D_Vloss'], 
                             ['A (Gauss)', 'B (Całka)', 'C (Stat)', 'D (Kriging)']):
            mean_val = df_res[col].mean()
            med_val = df_res[col].median()
            std_val = df_res[col].std()
            
            # Formatowanie, jeśli wszystkie wartości to NaN
            m_str = f"{mean_val:.3f}" if pd.notna(mean_val) else "   -   "
            md_str = f"{med_val:.3f}" if pd.notna(med_val) else "   -   "
            s_str = f"{std_val:.3f}" if pd.notna(std_val) else "   -   "
            
            print(f"{name:<15} | {m_str:<10} | {md_str:<10} | {s_str:<10}")
            
        print("=" * 85 + "\n")
    else:
        print("\nBrak wyników do podsumowania.")

if __name__ == "__main__":
    run_vloss_comparison()